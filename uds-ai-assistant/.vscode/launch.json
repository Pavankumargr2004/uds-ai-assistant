{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start UDS UI (Streamlit)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/uds_assistant/ui/app.py"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Start UDS API (FastAPI)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "uds_assistant.api.app:app",
                "--host", "127.0.0.1",
                "--port", "8000",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": true
        }
    ],
    "compounds": [
        {
            "name": "Run Full UDS Platform",
            "configurations": [
                "Start UDS API (FastAPI)",
                "Start UDS UI (Streamlit)"
            ]
        }
    ]
}
